# Eleven agent sidecar settings. Copy to agent/.env.local (gitignored), or put the values in the repo's
# .env.local. Never commit real values. `npm run check` prints which ones are set, by name only.

# SpacetimeDB (docs/spacetime.md). The identity token is written to agent/.agent-token by `npm run pair`.
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=say-when-dev
AGENT_TOKEN_FILE=

# The option planner (Claude). Or sign in with `ant auth login` instead of a key.
ANTHROPIC_API_KEY=
AGENT_PLANNER_MODEL=claude-haiku-5-5
AGENT_PLANNER_EFFORT=low
AGENT_PLANNER_TIMEOUT_MS=15000

# Web and place search, and the form errands (apify/client).
APIFY_TOKEN=
FORM_ERRAND_URL=
RAG_WEB_BROWSER_URL=
AGENT_SEARCH_TIMEOUT_MS=20000
# "lat,lng" of the venue, so place questions use the maps search near it.
AGENT_PLACES_NEAR=

# The person's memory (moss).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_SNAPSHOT_DIR=
AGENT_MOSS=on
AGENT_MOSS_REOPEN=off
AGENT_MEMORY_SHAREABLE=off

# Errand forms the planner may offer. See forms.example.json.
AGENT_FORMS_FILE=

# Outbound calls (stretch; cartesia). Off unless every call setting is present.
AGENT_CALLS=off
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CALL_CONSENT_FILE=
CALL_DO_NOT_CALL_FILE=
# Where the Dialer keeps holds on contacts, so a hold survives a restart. A private path.
CALL_HOLD_FILE=
CALL_CALLBACK_NUMBER=
CALL_PERSON_NAME=
CALL_ERRAND_TITLES=

# Everything else.
AGENT_TIME_ZONE=America/Los_Angeles
AGENT_MAX_JOBS=3
AGENT_MAX_OPTIONS=4
AGENT_ENV_FILES=on
