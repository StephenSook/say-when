# Copy to .env.local and fill in your own values. Never commit real keys.
# Each folder's README says which of these it reads.

# Apify: server side only, never in a browser bundle
APIFY_TOKEN=
# Standby URL of our form-errand Actor, copied from its Endpoints tab
FORM_ERRAND_URL=
# Comma-separated https:// prefixes the form-errand Actor may fill
ALLOWED_FORM_PREFIXES=
