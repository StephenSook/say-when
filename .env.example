# Copy to .env.local and fill in your own values. Never commit real keys.
# Each folder's README says which of these it reads.

# Apify: server side only, never in a browser bundle
APIFY_TOKEN=
# Standby URL of our form-errand Actor, copied from its Endpoints tab
FORM_ERRAND_URL=
# Comma-separated https:// prefixes the form-errand Actor may fill
ALLOWED_FORM_PREFIXES=
# RAG Web Browser Standby base URL; empty means https://rag-web-browser.apify.actor
RAG_WEB_BROWSER_URL=

# Moss: agent laptop only, never in a browser bundle, SpacetimeDB or git
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Absolute folder for the person's memory snapshot on this laptop, for example <repo>/moss/.memory (gitignored)
MOSS_SNAPSHOT_DIR=
# Optional: idle auto-close in milliseconds (default 180000, 3 minutes)
MOSS_IDLE_CLOSE_MS=
# Optional: session name, default say-when. Moss telemetry sends it as typed, so keep it neutral
MOSS_SESSION_NAME=

# Cartesia: server side only (token minting, dictionary sync, the call). Browsers only get short-lived access tokens
CARTESIA_API_KEY=
# Pronunciation dictionary id printed by `npm run dict:sync` in cartesia/ (an id, not a secret)
CARTESIA_PRONUNCIATION_DICT_ID=
# Optional library voice overrides, ids from `npm run voices` in cartesia/
CARTESIA_ASSISTANT_VOICE_ID=
CARTESIA_REPLY_VOICE_ID=
# CALL stretch: the published Managed Agent id and the Cartesia phone number id it calls from (ids, not numbers)
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
# CALL stretch: paths to private, gitignored files (see cartesia/README.md); or put the JSON and the list inline below
CALL_CONSENT_FILE=
CALL_DO_NOT_CALL_FILE=
CALL_CONSENT=
CALL_DO_NOT_CALL=
# CALL stretch: a consenting teammate's US number in E.164, read out on every call as the callback number
CALL_CALLBACK_NUMBER=
# CALL stretch: the name the call says it is calling for
CALL_PERSON_NAME=
